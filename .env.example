# Copie ce fichier en `.env` (jamais commité) : configuration de développement,
# lue par `npm run dev` et `npm run docker:dev`. La prod a son propre fichier : `.env.production.example`.

# MySQL de dev (`npm run db:up`)
DATABASE_URL=mysql://binderbound:binderbound@localhost:3316/binderbound
# Tests d'intégration MySQL (`npm run test:db`)
TEST_DATABASE_URL=mysql://binderbound:binderbound@localhost:3316/binderbound_test

# Connexion Google (optionnelle) : Client ID OAuth « Application Web » créé sur
# https://console.cloud.google.com/auth/clients
# Origines JavaScript autorisées : http://localhost:5173 (et le port de Vite utilisé).
GOOGLE_CLIENT_ID=
