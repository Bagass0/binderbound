{
  "name": "@binderbound/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch --watch-path=src --watch-path=data src/index.js",
    "start": "node --env-file-if-exists=../.env src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "import-set": "node scripts/import-set.js",
    "sync-sets": "node scripts/sync-sets.js",
    "test:db": "node --env-file=../.env ../node_modules/vitest/vitest.mjs run tests/accounts.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "google-auth-library": "^11.3.2",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
