# Bloc à ajouter au Caddyfile du VPS (/srv/guidevo/Caddyfile), puis recharger Caddy.
# Les enregistrements DNS A de binderbound.space et www doivent pointer vers le VPS.
# `binderbound` est l'alias de l'app sur le réseau Docker `proxy` (compose.vps.yaml).

binderbound.space {
	encode zstd gzip
	reverse_proxy binderbound:3001
}

www.binderbound.space {
	redir https://binderbound.space{uri} permanent
}
