# Configuration de production, lue par `npm run docker:prod` (compose.prod.yaml).
# Copie ce fichier en `.env.production` (jamais commité) et remplis chaque valeur.

# --- Base MySQL (interne à Docker, jamais exposée) ---
# Mots de passe longs et aléatoires, en hexadécimal (ils apparaissent dans une URL) :
#   openssl rand -hex 32
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Connexion Google ---
# Client OAuth « Binderbound prod » dont l'origine autorisée est l'URL publique (https://…).
# Vide = connexion par e-mail uniquement.
GOOGLE_CLIENT_ID=

# --- Réseau ---
# Port de la machine hôte sur lequel l'app écoute.
PORT=8080
# true dès que l'app est servie en HTTPS (obligatoire en ligne). false seulement pour tester en local.
COOKIE_SECURE=true
# Nombre de reverse proxies devant l'app (1 derrière Nginx, Traefik ou Caddy ; 0 sinon).
TRUST_PROXY=1
