{
  "name": "binderbound",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import-set": "npm run import-set -w server --",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose --env-file .env.production -f compose.prod.yaml up -d --build",
    "docker:prod:down": "docker compose --env-file .env.production -f compose.prod.yaml down",
    "sync-sets": "npm run sync-sets -w server --",
    "test:db": "npm run test:db -w server",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
